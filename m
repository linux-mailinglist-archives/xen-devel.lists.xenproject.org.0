-static int
-load_file(char *name, void **ptr, long *size)
-{
-    char *buf = NULL;
-    int allocated = 1 * 1024 * 1024;
-    int len, filled = 0;
-
-    if (!grub_open (name))
-        return -1;
-
-    buf = malloc(allocated);
-
-    errnum = 0;
-    while (1) {
-        len = grub_read (buf + filled, allocated - filled);
-        if (! len) {
-            if (!errnum)
-                break;
-            grub_close ();
-            return -1;
-        }
-        filled += len;
-        if (filled < allocated)
-            break;
-        allocated *= 2;
-        buf = realloc(buf, allocated);
-    }
-    grub_close ();
-    *ptr = buf;
-    *size = filled;
-    return 0;
-}
